# Hosted model configuration. Copy this file to .env for local use; do not commit .env.
# The application reads environment variables directly. Load .env with your deployment or shell tooling.

# Supported values: gemini, openai, openai_compatible
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0

# --- Gemini Provider Configuration ---
# GEMINI_API_KEY is required when LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Generic / OpenAI Provider Configuration ---
# LLM_API_KEY=replace-with-your-provider-api-key
# OPENAI_API_KEY=replace-with-your-openai-api-key
# LLM_MODEL=gpt-4.1-mini

# --- OpenAI-Compatible / Self-Hosted vLLM Configuration ---
# Required when LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1

# --- API & Observability Configuration ---
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
