# Hosted model configuration. Copy this file to .env for local use; do not commit .env.
# The application reads environment variables directly. Load .env with your deployment or shell tooling.

# Supported values: openai, openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0

# API configuration
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for OpenAI and OpenAI-compatible hosted endpoints.
# LLM_API_KEY takes precedence over OPENAI_API_KEY.
LLM_API_KEY=replace-with-your-provider-api-key
# OPENAI_API_KEY=replace-with-your-openai-api-key

# Required when LLM_PROVIDER=openai_compatible (for example, a vLLM server).
# LLM_BASE_URL=http://localhost:8000/v1
